# One-layer deployment: upload this directory's contents into public_html.
# Keep dl.php public, but block the app internals and the token file.
# Comment out Options if your host disallows it or you need directory listings.
Options -Indexes

<IfModule mod_authz_core.c>
    <FilesMatch "^(config|bootstrap)\.php$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^(config|bootstrap)\.php$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
    Header always set Access-Control-Allow-Headers "Accept, Authorization, Content-Type, Origin, Range, X-Requested-With"
    Header always set Access-Control-Expose-Headers "Accept-Ranges, Content-Disposition, Content-Length, Content-Range, Content-Type, ETag, Last-Modified"
    Header always set Access-Control-Max-Age "86400"

    <FilesMatch "\.(?:m3u8|mpd)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

<IfModule mod_setenvif.c>
    SetEnvIfNoCase Request_URI "\.(mp4|m4v|m4s|mkv|webm|ts|mp3|m4a|ogg|oga|opus|flac)$" no-gzip dont-vary
</IfModule>

<IfModule mod_mime.c>
    AddType video/mp4 .mp4 .m4v .m4s
    AddType video/x-matroska .mkv
    AddType video/webm .webm
    AddType application/vnd.apple.mpegurl .m3u8
    AddType application/dash+xml .mpd
    AddType video/mp2t .ts
    AddType audio/mpeg .mp3
    AddType audio/mp4 .m4a
    AddType audio/ogg .ogg .oga
    AddType audio/opus .opus
    AddType audio/flac .flac
    AddType text/vtt .vtt
    AddType application/x-subrip .srt
    AddCharset UTF-8 .m3u8 .mpd .vtt .srt
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} =OPTIONS
    RewriteRule ^ - [R=204,L]
    RewriteRule ^(src|tests|scripts)(/|$) - [F,L]
</IfModule>
